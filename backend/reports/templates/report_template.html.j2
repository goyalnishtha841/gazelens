<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Fixation Report — {{ session_id }}</title>
<style>
  @page {
    /* pdf_backends.py's Chromium path sets its own PDF margin box via
       Playwright's `margin` option (independent of this @page rule), tuned
       to leave enough room at the bottom for the footer below. This
       `margin` value is what WeasyPrint actually uses, if that backend
       becomes available on a given machine. */
    margin: 20mm 18mm 20mm 18mm;
    /* Renders on both backends: WeasyPrint via its native paged-media
       support, and -- confirmed by direct test, not assumed -- this
       Chromium build too, so no separate Playwright header/footer template
       is needed in pdf_backends.py. */
    @bottom-left { content: "FIXATION · CONFIDENTIAL"; font-family: "Courier New", monospace; font-size: 7pt; color: #999; letter-spacing: 0.08em; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font-family: "Courier New", monospace; font-size: 7pt; color: #999; }
  }

  /* Same tokens as frontend-new/src/index.css (light mode) -- monochromatic
     palette, one accent, no semantic red/amber/green. Severity below is
     conveyed by weight/emphasis, not hue, to match that. */
  :root {
    --bg: #f7f7f5;
    --surface: #ffffff;
    --ink: #111111;
    --ink-soft: #777777;
    --rule: #e7e7e4;
    --accent: #6c63ff;
    --accent-soft: #6c63ff1a;
  }

  * { box-sizing: border-box; }

  body {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: white;
    font-size: 10pt;
    line-height: 1.55;
    margin: 0;
  }

  .label {
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
  }

  /* Thin brand band at the top of the first page -- the one flourish a
     monochrome + single-accent palette can afford, used exactly once.
     Deliberately NOT bled to the physical page edge via negative margins:
     WeasyPrint honours the @page margin above, but the Chromium backend
     (pdf_backends.py) sets its own, different PDF margin box via
     Playwright's `margin` option -- the two don't agree on a number, so a
     bar sized to bleed against one would misalign under the other. Staying
     inside normal content flow works identically under both. */
  .accent-bar { height: 4px; background: var(--accent); border-radius: 2px; margin: 0 0 22px 0; }

  /* ---------- Masthead: a real cover strip, not a title-left/meta-right
     header row -- big title alone, then an itemized attribution/meta strip
     underneath, the way a delivered audit document opens. ---------- */
  .masthead { margin-bottom: 22px; }
  .masthead .kicker {
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .masthead h1 {
    font-size: 27pt;
    font-weight: 700;
    margin: 0 0 4px 0;
    letter-spacing: -0.015em;
  }
  .masthead .subtitle { font-size: 11pt; color: var(--ink-soft); }

  .meta-strip {
    display: flex;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
  }
  .meta-strip > div {
    flex: 1;
    padding-right: 16px;
  }
  .meta-strip .label { display: block; margin-bottom: 5px; }
  .meta-strip .meta-value {
    font-size: 10pt;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---------- Severity banner ---------- */
  .banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px;
    border-radius: 10px;
    border: 1px solid var(--rule);
    border-left-width: 3px;
    margin-bottom: 18px;
    font-size: 10pt;
    font-weight: 600;
    background: var(--surface);
    page-break-inside: avoid;
  }
  .banner-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--ink-soft); }
  .banner-critical { border-left-color: var(--accent); background: var(--accent-soft); }
  .banner-critical .banner-dot { background: var(--accent); }
  .banner-warning { border-left-color: var(--ink); }
  .banner-warning .banner-dot { background: var(--ink); }
  .banner-good { border-left-color: var(--rule); color: var(--ink-soft); font-weight: 500; }

  .summary-text {
    font-size: 10.5pt;
    line-height: 1.65;
    margin: 0 0 22px 0;
    color: var(--ink);
  }

  /* Section headers: a numbered badge + real heading, not just a small
     uppercase label standing in for one -- reads as document structure
     from across the room, the way a numbered report section should. */
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 32px 0 14px 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    page-break-after: avoid;
  }
  .section-title .section-num {
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 9pt;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .section-title .section-heading {
    font-size: 14pt;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* ---------- Stat cards ---------- */
  .summary-grid {
    display: flex;
    gap: 10px;
    margin-bottom: 4px;
    page-break-inside: avoid;
  }
  .summary-card {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 12px 14px;
  }
  .summary-card .label { display: block; margin-bottom: 5px; }
  .summary-card .value {
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 12pt;
    font-weight: 600;
    color: var(--ink);
  }

  /* ---------- Heatmap ---------- */
  .heatmap-block {
    text-align: center;
    margin: 12px 0 4px 0;
    page-break-inside: avoid;
  }
  .heatmap-block img { width: 100%; border: 1px solid var(--rule); border-radius: 10px; }
  .heatmap-caption { font-size: 7.5pt; color: var(--ink-soft); margin-top: 5px; }

  /* ---------- Issues table ---------- */
  table.issues { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
  table.issues thead { display: table-header-group; }
  table.issues tr { page-break-inside: avoid; }
  table.issues th {
    text-align: left;
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 7pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    border-bottom: 1.5px solid var(--ink);
    padding: 7px 8px;
  }
  table.issues td { padding: 9px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  table.issues tbody tr:nth-child(even) td { background: var(--bg); }
  .severity-pill {
    display: inline-block;
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 7pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 9px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    background: var(--surface);
  }
  .severity-High { border-color: var(--accent); color: var(--accent); }
  .severity-Medium { color: var(--ink); }
  .evidence-text { font-family: "SF Mono", "Courier New", monospace; font-size: 7.5pt; color: var(--ink-soft); }

  /* ---------- Recommendation cards ---------- */
  .rec-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ink-soft);
    border-radius: 10px;
    padding: 12px 15px;
    margin-bottom: 10px;
    page-break-inside: avoid;
  }
  .rec-card.support-Strong { border-left-color: var(--accent); }
  .rec-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 7px; }
  .rec-element { font-family: "SF Mono", "Courier New", monospace; font-size: 7.5pt; color: var(--ink-soft); }
  .confidence-meter { display: flex; align-items: center; gap: 6px; }
  .confidence-track { width: 55px; height: 4px; background: var(--rule); border-radius: 3px; overflow: hidden; }
  .confidence-fill { height: 100%; background: var(--accent); }
  .confidence-label { font-family: "SF Mono", "Courier New", monospace; font-size: 7.5pt; color: var(--ink-soft); }
  .rec-text { font-size: 9.5pt; line-height: 1.5; margin-bottom: 7px; color: var(--ink); }
  .rec-evidence-list { margin: 0; padding-left: 15px; font-size: 7.5pt; color: var(--ink-soft); font-family: "SF Mono", "Courier New", monospace; }

  /* ---------- Before / After ---------- */
  table.before-after { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin-bottom: 10px; }
  table.before-after thead { display: table-header-group; }
  table.before-after tr { page-break-inside: avoid; }
  table.before-after th {
    text-align: left;
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 7pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    border-bottom: 1.5px solid var(--ink);
    padding: 7px 8px;
  }
  table.before-after td { padding: 9px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  table.before-after tbody tr:nth-child(even) td { background: var(--bg); }
  .ba-element { font-family: "SF Mono", "Courier New", monospace; font-size: 7.8pt; width: 18%; color: var(--ink); }
  .ba-support { display: block; margin-top: 4px; font-size: 7pt; font-family: inherit; color: var(--ink-soft); }
  .ba-support.support-Strong { color: var(--accent); }
  .ba-before { font-family: "SF Mono", "Courier New", monospace; font-size: 7.5pt; color: var(--ink-soft); width: 38%; }
  .ba-after { font-size: 8.5pt; width: 44%; color: var(--ink); }
  .before-after-note { font-size: 7.3pt; color: var(--ink-soft); margin-bottom: 10px; }

  .rejected-block {
    margin-top: 14px;
    padding: 12px 15px;
    background: var(--bg);
    border: 1px dashed var(--rule);
    border-radius: 10px;
    font-size: 7.8pt;
    color: var(--ink-soft);
    page-break-inside: avoid;
  }
  .rejected-block h3 {
    font-family: "SF Mono", "Courier New", monospace;
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin: 0 0 6px 0;
    color: var(--ink);
  }

  .empty-state { font-size: 9pt; color: var(--ink-soft); padding: 6px 0; }
  .banner-insufficient { border-left-color: var(--ink); background: var(--accent-soft); }
  .banner-insufficient .banner-dot { background: var(--ink); }
  .quality-block { border: 1px solid var(--rule); padding: 8px 12px; margin: 10px 0 14px; font-size: 8.5pt; }
  .quality-head { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .quality-pill { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 7px; border: 1px solid var(--ink); }
  .quality-good { border-color: var(--rule); color: var(--ink-soft); }
  .quality-limited { border-color: var(--ink); }
  .quality-insufficient { background: var(--ink); color: #fff; }
  .quality-reasons { margin: 6px 0 0 16px; padding: 0; color: var(--ink-soft); }
  .issue-also, .issue-caveat, .rec-also { font-size: 7.5pt; color: var(--ink-soft); margin-top: 3px; }
  .issue-caveat { font-style: italic; }

  .footer-note {
    margin-top: 28px;
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    font-size: 7.5pt;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .footer-note strong { color: var(--ink); }
</style>
</head>
<body>

  <div class="accent-bar"></div>

  <div class="masthead">
    <div class="label kicker">Gaze-Driven UX Evaluation · Confidential</div>
    <h1>Fixation Report</h1>
    <div class="subtitle">{{ ui_page.replace("_", " ")|title }}</div>

    <div class="meta-strip">
      <div>
        <span class="label">Prepared by</span>
        <span class="meta-value">Fixation</span>
      </div>
      <div>
        <span class="label">Page evaluated</span>
        <span class="meta-value">{{ ui_page.replace("_", " ")|title }}</span>
      </div>
      <div>
        <span class="label">Session</span>
        <span class="meta-value">{{ session_id }}</span>
      </div>
      <div style="padding-right: 0;">
        <span class="label">Generated</span>
        <span class="meta-value">{{ generated_at }}</span>
      </div>
    </div>
  </div>

  <div class="banner banner-{{ banner_level }}">
    <span class="banner-dot"></span>
    <span>{{ banner_text }}</span>
  </div>

  <p class="summary-text">{{ summary_html|safe }}</p>

  {% if quality %}
  <div class="quality-block">
    <div class="quality-head">
      <span class="label">Measurement quality</span>
      <span class="quality-pill quality-{{ quality.level }}">{{ quality.level }}</span>
      {% if quality.gaze_error_px is not none %}
      <span>Gaze error <strong>{{ "%.0f"|format(quality.gaze_error_px) }} px</strong>
        ({{ "%.1f"|format(quality.gaze_error_pct_diagonal) }}% of screen,
        {{ "accuracy check" if quality.error_source == "accuracy_check" else "calibration estimate" }})</span>
      {% endif %}
    </div>
    {% if quality.reasons %}
    <ul class="quality-reasons">{% for r in quality.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
    {% endif %}
    {% if quality.level == "limited" %}
    <div class="issue-also">Severities are capped at Medium for this session.</div>
    {% endif %}
    {% if quality.low_confidence_elements %}
    <div class="issue-also">Too small to measure at this accuracy:
      {{ quality.low_confidence_elements|map("label")|join(", ") }}.</div>
    {% endif %}
  </div>
  {% endif %}

  <div class="summary-grid">
    <div class="summary-card">
      <div class="label">First Noticed</div>
      <div class="value">{{ behavior.first_noticed|label if behavior.first_noticed else "—" }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Most Attended</div>
      <div class="value">{{ behavior.most_attended|label if behavior.most_attended else "—" }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Attention Scattered</div>
      <div class="value">{{ "Yes" if behavior.attention_scattered else "No" }}</div>
    </div>
    <div class="summary-card">
      <div class="label">Issues Found</div>
      <div class="value">{{ issues|length }}</div>
    </div>
  </div>

  {% if heatmap_path %}
  <div class="heatmap-block">
    <img src="{{ heatmap_path }}" alt="Gaze heatmap over the page">
    {% if dwell_chart_path %}
    <div class="heatmap-caption">Where gaze actually went, over the page as it was shown. Blurred by the measured gaze error, so it is never sharper than the measurement. Dashed boxes are the elements attention was attributed to.</div>
    {% else %}
    <div class="heatmap-caption">Left: attention by page position. Right: share of total gaze time per element, ranked.</div>
    {% endif %}
  </div>
  {% endif %}

  {% if dwell_chart_path %}
  <div class="heatmap-block">
    <img src="{{ dwell_chart_path }}" alt="Attention per element and dwell-time ranking">
    <div class="heatmap-caption">Per element: left, attention by element; right, share of total gaze time per element, ranked.</div>
  </div>
  {% endif %}

  {% if scanpath_path %}
  <div class="heatmap-block">
    <img src="{{ scanpath_path }}" alt="Gaze path in visit order">
    <div class="heatmap-caption">Fixation sequence, in order -- green is first, red is last. The heatmap above shows how much attention each element got; this shows the order attention moved between them, which is what the layout-confusion and repeated-revisit findings below are based on.</div>
  </div>
  {% endif %}

  <div class="section-title"><span class="section-num">01</span><span class="section-heading">Usability Issues</span></div>
  {% if issues %}
  <table class="issues">
    <thead>
      <tr><th>Severity</th><th>Issue</th><th>Heuristic</th><th>Evidence</th></tr>
    </thead>
    <tbody>
      {% for issue in issues %}
      <tr>
        <td><span class="severity-pill severity-{{ issue.severity }}">{{ issue.severity }}</span></td>
        <td>{{ issue.issue }}<br><strong>{{ issue.element_label or (issue.element_id|label) }}</strong>
          {% if issue.also %}<div class="issue-also">Also: {{ issue.also|join("; ") }}</div>{% endif %}
          {% if issue.caveat %}<div class="issue-caveat">{{ issue.caveat }}</div>{% endif %}
        </td>
        <td>{{ issue.heuristic }}</td>
        <td class="evidence-text">{{ issue.evidence }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% elif quality and quality.level == "insufficient" %}
  <div class="empty-state">Not evaluated: the gaze data from this session isn't reliable enough to support findings (see Measurement quality above). Recalibrate and run the session again.</div>
  {% else %}
  <div class="empty-state">No usability issues detected against current thresholds.</div>
  {% endif %}

  <div class="section-title"><span class="section-num">02</span><span class="section-heading">Recommendations</span></div>
  {% if recommendations_kept %}
    {% for rec in recommendations_kept %}
    <div class="rec-card support-{{ rec.support }}">
      <div class="rec-header">
        <span class="rec-element">{{ rec.element_label or (rec.element_id|label) }} · {{ rec.support }}</span>
        <div class="confidence-meter">
          <div class="confidence-track">
            <div class="confidence-fill" style="width:{{ (rec.confidence * 100)|round|int }}%;"></div>
          </div>
          <span class="confidence-label">{{ "%.2f"|format(rec.confidence) }}</span>
        </div>
      </div>
      <div class="rec-text">{{ rec.recommendation }}</div>
      {% if rec.also %}<div class="rec-also">Also consider: {{ rec.also|join(" ") }}</div>{% endif %}
      {% if rec.measurability is defined and rec.measurability < 1 %}
      <div class="rec-also">Confidence reduced from {{ "%.2f"|format(rec.confidence_raw) }}: the element is small relative to the gaze error.</div>
      {% endif %}
      <ul class="rec-evidence-list">
        {% for e in rec.evidence %}<li>{{ e }}</li>{% endfor %}
      </ul>
    </div>
    {% endfor %}
  {% else %}
  <div class="empty-state">No recommendations passed verification for this session.</div>
  {% endif %}

  {% if recommendations_rejected %}
  <div class="rejected-block">
    <h3>Filtered by verification ({{ recommendations_rejected|length }})</h3>
    {% for rec in recommendations_rejected %}
    <div style="margin-bottom:5px;"><em>{{ rec.recommendation }}</em> — {{ rec.evidence|join("; ") }}</div>
    {% endfor %}
  </div>
  {% endif %}

  {% if before_after %}
  <div class="section-title"><span class="section-num">03</span><span class="section-heading">Before / After</span></div>
  <table class="before-after">
    <thead>
      <tr>
        <th>Element</th>
        <th>Before — measured</th>
        <th>After — recommended change</th>
      </tr>
    </thead>
    <tbody>
      {% for row in before_after %}
      <tr>
        <td class="ba-element">{{ row.element_id|label }}<br>
          <span class="ba-support support-{{ row.support }}">{{ row.support }} · {{ "%.2f"|format(row.confidence) }}</span>
        </td>
        <td class="ba-before">{{ row.before }}</td>
        <td class="ba-after">{{ row.after }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="before-after-note">
    "Before" is the critic's own re-verified evidence, not a re-lookup -- the same number the recommendation above
    is grounded in. "After" is the instruction, not a rendered mockup: nothing in this pipeline has measured what a
    redesigned page would actually produce, so no image is shown claiming to be one.
  </div>
  {% endif %}

  <div class="footer-note">
    <strong>Generated by Fixation</strong> · Gaze-Driven UX Evaluation Platform<br>
    Every recommendation above was independently re-verified against raw session metrics by the Critic/Verifier
    agent before inclusion. Filtered items were rejected for lacking measurable support.
  </div>

</body>
</html>

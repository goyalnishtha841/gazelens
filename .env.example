# =============================================================================
# GazeLens -- every setting the project reads, in one place.
#
# This is .env.example: the committed template, with every key and NO values.
# Copy it to .env (gitignored) and fill in what you use:
#   cp .env.example .env
#
# Local use (from backend/):
#   set -a && source ../.env && set +a && ../.venv/bin/uvicorn api.main:app --reload --port 8010
#
# Deploying: copy each ACTIVE line below into the host's settings
#   - API host (Render / Hugging Face Space / any Docker host): the backend keys
#   - Vercel (frontend): the VITE_* keys in section 9 (they live in frontend-new/)
# See DEPLOY.md for where each one goes.
#
# Lines starting with "# KEY=" are optional and show the DEFAULT. Leave them
# commented unless you want to change it: an empty value (KEY=) would replace
# the default with nothing and can stop the API from starting.
# =============================================================================


# --- 1. Login security --------------------------------------------------------
# Signs every login token. REQUIRED when deployed (the API refuses to start
# with GAZELENS_ENV=production and no key). Empty locally = a key is generated
# into backend/api/.secret_key. Use a NEW key for production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (The older name FIXATION_SECRET_KEY still works; use this one.)
GAZELENS_SECRET_KEY=

# "production" makes the missing key above a startup error. The Docker image
# already sets it; leave commented locally.
# GAZELENS_ENV=production

# How long a login lasts, in minutes (12 hours).
# FIXATION_TOKEN_TTL_MINUTES=720

# Failed logins allowed per IP per window before HTTP 429 (10 per 15 min).
# GAZELENS_LOGIN_MAX_FAILURES=10
# GAZELENS_LOGIN_WINDOW_SECONDS=900


# --- 2. Sign in with Google ---------------------------------------------------
# OAuth client ID from Google Cloud -> Google Auth Platform -> Clients.
# Public, not a secret. Empty = Google button hidden.
# When deployed, add the site's https:// address to the client's
# "Authorized JavaScript origins" in Google Cloud.
GOOGLE_CLIENT_ID=


# --- 3. Private admin page (/admin) ---------------------------------------------
# Empty = admin page switched off (its routes answer 404).
GAZELENS_ADMIN_PASSWORD=
# Admin login length (2 h) and lockout (5 wrong passwords per 15 min per IP).
# GAZELENS_ADMIN_TOKEN_TTL_MINUTES=120
# GAZELENS_ADMIN_MAX_FAILURES=5
# GAZELENS_ADMIN_WINDOW_SECONDS=900


# --- 4. AI writing for the report agents (optional) -----------------------------
# With a key, agents 1-3 write their text with an LLM and the critic checks
# every number in it. Empty = rule-based text only. Groq has a free tier:
# https://console.groq.com/keys . If both keys are set, Claude is used.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# "groq" or "anthropic" when both keys are set.
# GAZELENS_LLM_PROVIDER=groq
# Override the model (defaults: openai/gpt-oss-120b on Groq, claude-opus-5-5).
# GAZELENS_LLM_MODEL=openai/gpt-oss-120b
# low | medium | high
# GAZELENS_LLM_EFFORT=medium
# "off" forces rule-based text even with a key set.
# GAZELENS_LLM=off


# --- 5. Which websites may call the API (CORS) ---------------------------------
# Only needed when the frontend and API are on DIFFERENT addresses (deployed).
# Default allows the local web app: localhost:5180, 127.0.0.1:5180, localhost:5173.
# GAZELENS_CORS_ORIGINS=https://gazelens.vercel.app
# Extra origins by pattern, e.g. Vercel preview deployments:
# GAZELENS_CORS_ORIGIN_REGEX=^https://gazelens(-[a-z0-9-]+)?\.vercel\.app$


# --- 6. Where data is stored ------------------------------------------------------
# Defaults are inside backend/. On a host, point them at a persistent disk
# (the Docker image uses /data), or every restart wipes accounts and reports.
# FIXATION_DATABASE_URL=sqlite:////data/gazelens.db
# FIXATION_DATA_DIR=/data/sessions
# GAZELENS_CALIBRATION_DIR=/data/calibration
# GAZELENS_GAZE_MODEL_DIR=/data/gaze_models
# Where a generated signing key is kept when GAZELENS_SECRET_KEY is empty.
# FIXATION_SECRET_FILE=/data/.secret_key


# --- 7. Report generation -----------------------------------------------------------
# Seconds a report may stay "processing" before it counts as failed and can
# be retried (10 min).
# GAZELENS_ANALYSIS_TIMEOUT_SECONDS=600


# --- 8. Research only: pupil detector ablation ---------------------------------------
# Live gaze uses MediaPipe iris landmarks and needs none of these.
# iris (default) | fused | yolo
# FIXATION_PUPIL_SOURCE=iris
# FIXATION_PUPIL_WEIGHTS=models/pupil_yolo_final.pt
# 0 turns off iris/YOLO fusion when the source is "fused".
# FIXATION_PUPIL_FUSION=1


# --- 9. Frontend settings (Vite) -------------------------------------------------------
# These are read from frontend-new/, NOT from this file. Locally put them in
# frontend-new/.env.local (gitignored); on Vercel, add them under Project -> Settings ->
# Environment Variables (they are baked in at build time).
#   VITE_API_BASE_URL   the deployed API's https:// address (unset locally)
#   VITE_ADMIN_PATH     address of the admin page (default /admin)
#   VITE_PROXY_TARGET   local dev only: where `npm run dev` sends /api

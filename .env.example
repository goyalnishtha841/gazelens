# Environment variables GazeLens reads. Locally: export them (or copy to .env,
# which is gitignored). Deployed: set them in the Render / Vercel dashboards.

# --- backend ---------------------------------------------------------------
# REQUIRED in production. Signs login tokens; anyone with it can impersonate
# any participant. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GAZELENS_SECRET_KEY=

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed with the Vercel rewrites (same origin); needed with
# VITE_API_BASE_URL, e.g. https://gazelens.vercel.app
GAZELENS_CORS_ORIGINS=http://localhost:5180

# "production" refuses to start without GAZELENS_SECRET_KEY. The deployed
# image (backend/Dockerfile) sets this already.
# GAZELENS_ENV=production

# Failed logins allowed per client IP per window before 429s.
# GAZELENS_LOGIN_MAX_FAILURES=10
# GAZELENS_LOGIN_WINDOW_SECONDS=900

# Optional LLM writing for the report agents (see README "Configuration").
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Storage (the deployed image points all of these under /data):
# FIXATION_DATABASE_URL=sqlite:////data/gazelens.db
# FIXATION_DATA_DIR=/data/sessions
# GAZELENS_CALIBRATION_DIR=/data/calibration
# GAZELENS_GAZE_MODEL_DIR=/data/gaze_models

# --- frontend (build time) --------------------------------------------------
# Leave unset when /api is served same-origin (Vite proxy, Vercel rewrites). Set to the API's URL to call it cross-origin instead.
# VITE_API_BASE_URL=https://gazelens-api.onrender.com
# Dev only: where `npm run dev` proxies /api.
# VITE_PROXY_TARGET=http://localhost:8000
